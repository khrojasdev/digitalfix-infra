# DigitalFix - variables de la capa de datos.
#
# Copia este archivo a .env y pon valores reales. El .env NO se versiona:
# esta en el .gitignore y no debe subirse nunca al repositorio.
#
#   Copy-Item .env.example .env

# --- Oracle XE ---------------------------------------------------------------
# Contrasena de SYS y SYSTEM. Minimo 8 caracteres, sin comillas ni @.
ORACLE_PASSWORD=cambiame_en_tu_env
# Usuario de aplicacion que crea la propia imagen, aparte de los cinco esquemas.
ORACLE_APP_USER=digitalfix
ORACLE_APP_PASSWORD=cambiame_en_tu_env
ORACLE_PORT=1521

# --- Cadena de conexion que usan los microservicios --------------------------
# Cada servicio apunta a su propio esquema con su propio usuario.
# Ejemplo para ms-digitalfix-catalog:
#   SPRING_DATASOURCE_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1
#   SPRING_DATASOURCE_USERNAME=DFX_CATALOG
#   SPRING_DATASOURCE_PASSWORD=digitalfix

# --- Mensajeria (se activa en la fase F3) ------------------------------------
# RABBIT_USER=digitalfix
# RABBIT_PASSWORD=cambiame_en_tu_env
# RABBIT_PORT=5672
# RABBIT_UI_PORT=15672
# KAFKA_PORT=9092
